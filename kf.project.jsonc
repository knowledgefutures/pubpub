{
	"$schema": "https://console.knowledgefutures.org/schemas/kf.project.v2.json",
	"version": 2,
	"slug": "kf-pubpub",
	"name": "PubPub",
	"account": "kf",

	// Deployed by .github/workflows/deploy.yml to Docker Swarm on PubPub's own
	// servers, not by the console. The console keeps each environment's key and
	// SSH deploy key, and hands its values to that workflow's run on its ref
	// (kf ci ssh-agent, kf ci secrets --runtime). The sops config is
	// infra/.sops.yaml.
	"environments": {
		"production": {
			"ref": "tags/v*", // a published release's tag
			"secrets": ["infra/.env.enc"],
			"elsewhere": { "workflow": ".github/workflows/deploy.yml" }
		},
		// DuqDuq
		"dev": {
			"ref": "heads/main",
			"secrets": ["infra/.env.dev.enc"],
			"elsewhere": { "workflow": ".github/workflows/deploy.yml" }
		}
	}
}
